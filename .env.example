# ==============================================================================
# Afreen Mall Internal Operations Platform - Environment Configuration Example
# ==============================================================================

# ── Backend API Configuration (apps/api/.env) ─────────────────────────────────
# PostgreSQL Database Connection String (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/afreen_mall?schema=public"

# Redis Cache & Message Queue URL (Optional)
REDIS_URL="redis://localhost:6379"

# API Listening Port (Default: 4000)
PORT=4000

# Authentication & Session Security Keys
JWT_SECRET="replace_with_a_secure_random_64_character_hex_string"
JWT_REFRESH_SECRET="replace_with_another_secure_random_64_character_hex_string"

# Node Execution Environment (development | production | test)
NODE_ENV="development"

# Allowed CORS Origins (comma-separated for multi-domain setup)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# ── Frontend Web Configuration (apps/web/.env.local) ───────────────────────────
# Base URL pointing to the Backend API server
VITE_API_URL="http://localhost:4000"
VITE_API_BASE_URL="http://localhost:4000/api"

# ── Export & Report Generation Libraries (Part 4 Note) ───────────────────────
# Note: Native PDF and Excel export features (PDFKit, ExcelJS) operate
# purely in-memory in local runtime. NO external third-party API keys or
# cloud service credentials (e.g., AWS S3, Cloudinary) are required.
